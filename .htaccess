# Árvore do Bem · Fundação Edmílson
# https://arvoredobem.fundacaoedmilson.org.br

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# ---------------------------------------------------------------
# HTTPS e domínio canônico
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://arvoredobem.fundacaoedmilson.org.br%{REQUEST_URI} [L,R=301]

  # Remove www, se alguém digitar
  RewriteCond %{HTTP_HOST} ^www\.arvoredobem\.fundacaoedmilson\.org\.br$ [NC]
  RewriteRule ^ https://arvoredobem.fundacaoedmilson.org.br%{REQUEST_URI} [L,R=301]

  # /index.html vira /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Bloqueia arquivos ocultos, exceto /.well-known
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

ErrorDocument 404 /404.html

# ---------------------------------------------------------------
# Tipos de arquivo
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json  webmanifest
  AddType image/svg+xml               svg
  AddType image/x-icon                ico
  AddType text/plain                  txt
  AddType text/markdown               md
  AddCharset utf-8 .txt .md .webmanifest .xml .svg .html .css .js
</IfModule>

# ---------------------------------------------------------------
# Cabeçalhos de segurança
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # Fontes do Google, envio do formulário pelo FormSubmit e links para o WhatsApp
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formsubmit.co; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# ---------------------------------------------------------------
# Compressão
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/markdown
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ---------------------------------------------------------------
# Cache
# As imagens usam ?v= no endereço, então podem ficar em cache por muito tempo.
# O HTML é sempre revalidado para que mudanças apareçam na hora.
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 week"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/manifest+json     "access plus 1 week"
  ExpiresByType text/plain                    "access plus 1 day"
  ExpiresByType application/xml               "access plus 1 day"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
